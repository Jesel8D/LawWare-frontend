# Copiar a .env.local; nunca incluir credenciales reales en Git.
# Solo funciona en `next dev`; en build/start de producción siempre está deshabilitado.
LAWWARE_DEMO=1
# Opcional. Solo servidor; ejemplo local para el backend independiente.
LAWWARE_BACKEND_URL=http://127.0.0.1:3001
# Configuración Auth0 real pendiente; completar exclusivamente en entorno autorizado.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=
APP_BASE_URL=http://127.0.0.1:3000
